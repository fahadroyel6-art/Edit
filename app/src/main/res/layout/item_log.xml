<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="horizontal" android:paddingTop="5dp" android:paddingBottom="5dp"
    android:background="?attr/selectableItemBackground">
    <TextView android:id="@+id/tvLevel" android:layout_width="38dp" android:layout_height="wrap_content"
        android:text="INFO" android:textColor="@color/text_secondary" android:textSize="9sp"
        android:textStyle="bold" android:fontFamily="monospace" />
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1" android:orientation="vertical">
        <TextView android:id="@+id/tvMsg" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="" android:textColor="@color/text_primary" android:textSize="11sp"
            android:fontFamily="monospace" />
        <TextView android:id="@+id/tvTag" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="" android:textColor="@color/text_tertiary" android:textSize="9sp"
            android:fontFamily="monospace" />
    </LinearLayout>
    <TextView android:id="@+id/tvTime" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="" android:textColor="@color/text_tertiary" android:textSize="9sp"
        android:fontFamily="monospace" android:layout_marginStart="6dp" />
</LinearLayout>
