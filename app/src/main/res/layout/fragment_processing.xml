<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/bg_dark"
    android:fitsSystemWindows="true" android:gravity="center" android:padding="24dp">

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="মার্জ হচ্ছে" android:textColor="@color/text_primary"
        android:textSize="21sp" android:textStyle="bold" />
    <TextView android:id="@+id/tvMode" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="Lossless stream copy" android:textColor="@color/accent" android:textSize="12sp"
        android:layout_marginTop="3dp" />

    <FrameLayout android:layout_width="190dp" android:layout_height="190dp" android:layout_marginTop="26dp">
        <ProgressBar android:id="@+id/progressBar" style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="190dp" android:layout_height="190dp"
            android:progressDrawable="@drawable/circular_progress" android:progress="0" android:max="100" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
            android:orientation="vertical" android:gravity="center">
            <TextView android:id="@+id/tvPercent" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="0%"
                android:textColor="@color/accent" android:textSize="38sp" android:textStyle="bold" />
        </LinearLayout>
    </FrameLayout>

    <TextView android:id="@+id/tvStatus" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:text="প্রস্তুত হচ্ছে…"
        android:textColor="@color/text_primary" android:textSize="13sp" android:gravity="center"
        android:layout_marginTop="22dp" />

    <TextView android:id="@+id/tvElapsed" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:text="সময়: 00:00"
        android:textColor="@color/text_secondary" android:textSize="12sp" android:layout_marginTop="6dp" />
    <TextView android:id="@+id/tvRemaining" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:text="বাকি: হিসাব হচ্ছে…"
        android:textColor="@color/text_secondary" android:textSize="12sp" android:layout_marginTop="2dp" />

    <TextView android:id="@+id/tvThermal" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:text="" android:visibility="gone"
        android:textColor="@color/warn" android:textSize="12sp" android:gravity="center"
        android:layout_marginTop="12dp" />

    <TextView android:id="@+id/tvErrorCode" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:text="" android:visibility="gone"
        android:textColor="@color/danger" android:textSize="12sp"
        android:textStyle="bold" android:layout_marginTop="12dp" />

    <View android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />

    <com.google.android.material.button.MaterialButton android:id="@+id/btnError"
        android:layout_width="match_parent" android:layout_height="48dp" android:visibility="gone"
        android:text="Copy Error Report" app:cornerRadius="14dp"
        android:backgroundTint="@color/danger" android:textColor="@color/text_primary" />

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:layout_marginTop="8dp">
        <com.google.android.material.button.MaterialButton android:id="@+id/btnPause"
            android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1"
            android:layout_marginEnd="5dp" android:text="Pause" app:cornerRadius="14dp"
            android:backgroundTint="@color/surface" android:textColor="@color/accent"
            app:strokeColor="@color/stroke" app:strokeWidth="1.5dp" />
        <com.google.android.material.button.MaterialButton android:id="@+id/btnCancel"
            android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1"
            android:layout_marginStart="5dp" android:text="Cancel" app:cornerRadius="14dp"
            android:backgroundTint="@color/surface" android:textColor="@color/danger"
            app:strokeColor="@color/danger" app:strokeWidth="1.5dp" />
    </LinearLayout>
</LinearLayout>
