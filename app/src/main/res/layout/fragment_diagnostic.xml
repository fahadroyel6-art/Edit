<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/bg_dark" android:fitsSystemWindows="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="16dp">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Diagnostic Center" android:textColor="@color/text_primary"
                    android:textSize="21sp" android:textStyle="bold" />
                <TextView android:id="@+id/tvHealth" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="—" android:textSize="11sp"
                    android:textColor="@color/accent" />
            </LinearLayout>
            <com.google.android.material.button.MaterialButton android:id="@+id/btnBack"
                style="@style/Widget.Material3.Button.TextButton" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="✕" android:textColor="@color/text_secondary" />
        </LinearLayout>

        <!-- Stage / job -->
        <com.google.android.material.card.MaterialCardView android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="10dp"
            app:cardBackgroundColor="@color/surface" app:cardCornerRadius="14dp"
            app:cardElevation="0dp" app:strokeColor="@color/stroke" app:strokeWidth="1dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="14dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="CURRENT STAGE" android:textColor="@color/text_tertiary"
                    android:textSize="9sp" android:textStyle="bold" />
                <TextView android:id="@+id/tvStage" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:text="Idle"
                    android:textColor="@color/text_primary" android:textSize="12sp" />
                <TextView android:id="@+id/tvJobId" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:text="—"
                    android:textColor="@color/text_secondary" android:textSize="10sp"
                    android:fontFamily="monospace" android:layout_marginTop="2dp" />
                <TextView android:id="@+id/tvLastSuccess" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:text="—"
                    android:textColor="@color/accent" android:textSize="10sp" android:layout_marginTop="4dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Live counters -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginTop="10dp">
            <TextView android:id="@+id/tvMemory" android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:text="Heap —" android:textColor="@color/text_primary"
                android:textSize="10sp" />
            <TextView android:id="@+id/tvNativeHeap" android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:text="Native —" android:textColor="@color/text_primary"
                android:textSize="10sp" />
            <TextView android:id="@+id/tvCpu" android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:text="CPU —" android:textColor="@color/text_primary"
                android:textSize="10sp" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginTop="4dp">
            <TextView android:id="@+id/tvStorage" android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:text="Free —" android:textColor="@color/text_primary"
                android:textSize="10sp" />
            <TextView android:id="@+id/tvThermal" android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:text="Thermal —" android:textSize="10sp"
                android:textColor="@color/accent" />
            <TextView android:id="@+id/tvBattery" android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:text="Battery —" android:textColor="@color/text_primary"
                android:textSize="10sp" />
        </LinearLayout>
        <TextView android:id="@+id/tvLowMem" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="⚠️ LOW MEMORY"
            android:textColor="@color/danger" android:textSize="10sp" android:textStyle="bold"
            android:visibility="gone" android:layout_marginTop="4dp" />

        <!-- Components -->
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="ENGINE COMPONENTS" android:textColor="@color/text_tertiary"
            android:textSize="9sp" android:textStyle="bold" android:layout_marginTop="14dp" />
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/rvComponents"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

        <!-- Log counters -->
        <com.google.android.material.card.MaterialCardView android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="12dp"
            app:cardBackgroundColor="@color/surface" app:cardCornerRadius="14dp"
            app:cardElevation="0dp" app:strokeColor="@color/stroke" app:strokeWidth="1dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:padding="12dp">
                <TextView android:id="@+id/tvCountInfo" android:layout_width="0dp"
                    android:layout_height="wrap_content" android:layout_weight="1" android:text="INFO 0"
                    android:textColor="@color/text_secondary" android:textSize="10sp" />
                <TextView android:id="@+id/tvCountWarn" android:layout_width="0dp"
                    android:layout_height="wrap_content" android:layout_weight="1" android:text="WARN 0"
                    android:textColor="@color/warn" android:textSize="10sp" />
                <TextView android:id="@+id/tvCountErr" android:layout_width="0dp"
                    android:layout_height="wrap_content" android:layout_weight="1" android:text="ERR 0"
                    android:textColor="@color/danger" android:textSize="10sp" />
                <TextView android:id="@+id/tvCountCrit" android:layout_width="0dp"
                    android:layout_height="wrap_content" android:layout_weight="1" android:text="CRIT 0"
                    android:textColor="@color/danger" android:textSize="10sp" android:textStyle="bold" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <TextView android:id="@+id/tvLogStorage" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="লগ স্টোরেজ: —"
            android:textColor="@color/text_tertiary" android:textSize="10sp"
            android:layout_marginTop="4dp" />

        <!-- Last error -->
        <com.google.android.material.card.MaterialCardView android:id="@+id/cardLastError"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="10dp" android:visibility="gone"
            app:cardBackgroundColor="@color/surface" app:cardCornerRadius="14dp"
            app:cardElevation="0dp" app:strokeColor="@color/danger" app:strokeWidth="1dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="14dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <TextView android:id="@+id/tvErrorCode" android:layout_width="0dp"
                        android:layout_height="wrap_content" android:layout_weight="1"
                        android:text="UVM-0000" android:textColor="@color/danger"
                        android:textSize="11sp" android:textStyle="bold" android:fontFamily="monospace" />
                    <TextView android:id="@+id/tvErrorTime" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:text="" android:textColor="@color/text_tertiary"
                        android:textSize="9sp" />
                </LinearLayout>
                <TextView android:id="@+id/tvErrorMsg" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:text=""
                    android:textColor="@color/text_secondary" android:textSize="10sp"
                    android:layout_marginTop="4dp" android:maxLines="4" android:ellipsize="end" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Actions -->
        <com.google.android.material.button.MaterialButton android:id="@+id/btnLogs"
            android:layout_width="match_parent" android:layout_height="46dp" android:layout_marginTop="14dp"
            android:text="Live Log Viewer" android:textSize="13sp" app:cornerRadius="12dp"
            android:backgroundTint="@color/accent" android:textColor="@color/bg_dark" />
        <com.google.android.material.button.MaterialButton android:id="@+id/btnCopyReport"
            android:layout_width="match_parent" android:layout_height="46dp" android:layout_marginTop="6dp"
            android:text="Copy Full Error Report" android:textSize="13sp" app:cornerRadius="12dp"
            android:backgroundTint="@color/surface" android:textColor="@color/accent"
            app:strokeColor="@color/accent" app:strokeWidth="1dp" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginTop="6dp">
            <com.google.android.material.button.MaterialButton android:id="@+id/btnExportTxt"
                android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1"
                android:layout_marginEnd="3dp" android:text="Export TXT" android:textSize="11sp"
                app:cornerRadius="12dp" android:backgroundTint="@color/surface"
                android:textColor="@color/text_secondary" app:strokeColor="@color/stroke" app:strokeWidth="1dp" />
            <com.google.android.material.button.MaterialButton android:id="@+id/btnExportJson"
                android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1"
                android:layout_marginStart="3dp" android:text="Export JSON" android:textSize="11sp"
                app:cornerRadius="12dp" android:backgroundTint="@color/surface"
                android:textColor="@color/text_secondary" app:strokeColor="@color/stroke" app:strokeWidth="1dp" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginTop="6dp">
            <com.google.android.material.button.MaterialButton android:id="@+id/btnCrashReport"
                android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1"
                android:layout_marginEnd="3dp" android:text="Last Crash" android:textSize="11sp"
                app:cornerRadius="12dp" android:backgroundTint="@color/surface"
                android:textColor="@color/warn" app:strokeColor="@color/stroke" app:strokeWidth="1dp" />
            <com.google.android.material.button.MaterialButton android:id="@+id/btnClearLogs"
                android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1"
                android:layout_marginStart="3dp" android:text="Clear Logs" android:textSize="11sp"
                app:cornerRadius="12dp" android:backgroundTint="@color/surface"
                android:textColor="@color/danger" app:strokeColor="@color/stroke" app:strokeWidth="1dp" />
        </LinearLayout>
        <com.google.android.material.button.MaterialButton android:id="@+id/btnSelfTest"
            style="@style/Widget.Material3.Button.TextButton" android:layout_width="match_parent"
            android:layout_height="44dp" android:text="🧪 Run Automated Tests"
            android:textColor="@color/text_secondary" android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
